# Copia este archivo como .env.local y llena los datos de TU proyecto de Supabase
# (Supabase → Project Settings → API). Si los dejas vacíos, la app guarda todo
# solo en este navegador.
#
# La llave "anon" es pública por diseño: la seguridad la ponen las reglas de
# supabase/schema.sql. NUNCA pongas aquí la llave "service_role".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
